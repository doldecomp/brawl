
#ifndef STL_TYPE_TRAITS_H
#define STL_TYPE_TRAITS_H

namespace std {
    template <typename T>
    struct remove_pointer {
        typedef T type;
    };

    // Specializations for pointer types
    template <typename T>
    struct remove_pointer<T*> {
        typedef T type;
    };

    template <typename T>
    struct remove_pointer<T* const> {
        typedef T type;
    };

    template <typename T>
    struct remove_pointer<T* volatile> {
        typedef T type;
    };

    template <typename T>
    struct remove_pointer<T* const volatile> {
        typedef T type;
    };
}

#endif //STL_TYPE_TRAITS_H