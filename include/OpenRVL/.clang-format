---
BasedOnStyle: LLVM
Language: Cpp
SortIncludes: "true"
SortUsingDeclarations: "true"
UseTab: Never
IndentWidth: 4
PointerAlignment: Left
ConstructorInitializerAllOnOneLineOrOnePerLine: true
FixNamespaceComments: true
AccessModifierOffset: -4
# Leave the contents of these macro invocations untouched (inline PPC asm)
WhitespaceSensitiveMacros: [ASM, ASM_VOLATILE]
